# Do not use /dev/sdX names: with both SATA and USB present the lettering moves.
# Root: noatime + commit=60 reduce idle writes so hdparm -S 120 can spin down.
LABEL=rootfs	/	ext4	errors=remount-ro,noatime,commit=60	0	1
proc		/proc	proc	defaults		0	0
sysfs		/sys	sysfs	defaults		0	0
LABEL=data	/srv/data	ext4	defaults,noatime,nofail	0	2
